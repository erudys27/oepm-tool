#!/usr/bin/env bash
# Interactively adds oepm wiring to the current directory (your project -
# new or existing). Run this FROM your project's own directory, pointing
# at wherever you cloned oepm-tool:
#   /path/to/oepm-tool/oepm-init
# Prompts for registries, then delegates to oepm-tool's own scaffoldProject
# Gradle task (see build.gradle.kts) to actually write/patch files.
set -e
set -o pipefail

TOOL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET_DIR="$(pwd)"

registries=""
while true; do
    read -r -p "Registry prefix (e.g. ba.), or leave blank to stop adding registries: " prefix
    [ -z "$prefix" ] && break

    read -r -p "Catalog URL for \"$prefix\": " url
    if [ -z "$url" ]; then
        echo "No URL given, skipping this registry."
        continue
    fi

    if [ -n "$registries" ]; then
        registries="$registries,$prefix=$url"
    else
        registries="$prefix=$url"
    fi

    read -r -p "Add another registry? [y/N]: " again
    case "$again" in
        [yY]*) ;;
        *) break ;;
    esac
done

run_scaffold() {
    "$TOOL_DIR/gradlew" -p "$TOOL_DIR" scaffoldProject \
        -PtargetDir="$TARGET_DIR" \
        ${registries:+-Pregistries="$registries"} \
        "$@"
}

output_file="$(mktemp)"
if run_scaffold 2>&1 | tee "$output_file"; then
    rm -f "$output_file"
    exit 0
fi

if grep -q "PACKAGE_NAME_REQUIRED" "$output_file"; then
    rm -f "$output_file"
    echo
    echo "Couldn't automatically determine package_name for your project."
    read -r -p "Enter package_name (e.g. example.myproject): " package_name
    [ -n "$package_name" ] || { echo "package_name is required."; exit 1; }
    run_scaffold "-PpackageName=$package_name"
else
    rm -f "$output_file"
    exit 1
fi
